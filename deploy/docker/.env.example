# 复制成 .env 后填好（.env 不要提交）

# 镜像：我们自己的 CI 产物
AGENT2API_IMAGE=ghcr.io/knownothing20/agent2api-fix:latest

# 面板监听地址：填本机局域网 IP（或 0.0.0.0 放开全部网卡）
AGENT2API_BIND_ADDRESS=192.168.31.124

# 面板管理员（首次启动写入数据库；之后改这里不会改已存在的账号）
AGENT2API_ADMIN_USER=admin
AGENT2API_ADMIN_PASSWORD=change-me

# 人机验证：纯内网部署可关（关掉后登录页不再要求验证）
AGENT2API_CAPTCHA_ENABLED=0
